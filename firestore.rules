rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Plan, Bewertungen, Lieblingsessen, Rezepte: für alle angemeldeten Geräte der App
    match /{coll}/{doc} {
      allow read, write: if request.auth != null
        && coll in ['plan', 'ratings', 'favs', 'recipes'];
    }

    // Wunschessen: alle dürfen lesen, ändern und löschen darf nur das Gerät, das den Wunsch angelegt hat
    match /wishes/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (!('uid' in resource.data) || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null
        && (!('uid' in resource.data) || resource.data.uid == request.auth.uid);
    }
  }
}
