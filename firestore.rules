rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Nur die Sammlungen der App, nur für angemeldete (anonyme) Geräte
    match /{coll}/{doc} {
      allow read, write: if request.auth != null
        && coll in ['plan', 'ratings', 'wishes', 'favs', 'recipes'];
    }
  }
}
